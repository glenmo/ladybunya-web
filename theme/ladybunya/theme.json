{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "base",      "color": "#FAF7F2", "name": "Bone Light" },
        { "slug": "contrast",  "color": "#6F7774", "name": "Warm Grey" },
        { "slug": "primary",   "color": "#1F4E4A", "name": "Ocean Green" },
        { "slug": "secondary", "color": "#C9A45C", "name": "Gold" },
        { "slug": "tertiary",  "color": "#E4A6B0", "name": "Soft Rose" },
        { "slug": "surface",   "color": "#FFFFFF", "name": "Surface white" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Fraunces",
          "fontFamily": "Fraunces, Georgia, 'Times New Roman', serif",
          "fontFace": [
            {
              "fontFamily": "Fraunces",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/fraunces-400.woff2" ]
            },
            {
              "fontFamily": "Fraunces",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/fraunces-500.woff2" ]
            },
            {
              "fontFamily": "Fraunces",
              "fontWeight": "600",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/fraunces-600.woff2" ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Mulish",
          "fontFamily": "Mulish, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Mulish",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/mulish-400.woff2" ]
            },
            {
              "fontFamily": "Mulish",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/mulish-500.woff2" ]
            },
            {
              "fontFamily": "Mulish",
              "fontWeight": "700",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/mulish-700.woff2" ]
            }
          ]
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "18px",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "500",
          "lineHeight": "1.15"
        },
        "color": { "text": "var(--wp--preset--color--primary)" }
      },
      "h1": { "typography": { "fontSize": "clamp(2.4rem, 5vw, 3.6rem)" } },
      "h2": { "typography": { "fontSize": "clamp(1.8rem, 3.5vw, 2.4rem)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--secondary)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--secondary)",
            "text": "var(--wp--preset--color--primary)"
          }
        }
      }
    }
  }
}
